generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum InvitationStatus {
  DRAFT // to'ldirilmoqda (bot suhbati yoki admin qoralamasi), subdomen yopiq
  PENDING // mijoz botda tugatdi, admin tasdiqlashini kutmoqda
  PUBLISHED // subdomen ochiq (sinov kuni yoki to'langan muddat - expiresAt belgilaydi)
  ARCHIVED // muddati tugagan yoki to'y o'tgan
}

enum InvitationSource {
  ADMIN // admin o'zi kiritgan
  BOT // Telegram bot orqali mijoz to'ldirgan
}

enum Locale {
  UZ
  RU
}

enum Attendance {
  YES
  NO
  MAYBE
}

// ─── Taklifnoma ───────────────────────────────────────────────────────────

model Invitation {
  id         String           @id @default(cuid())
  /// Subdomen: nodir-malika.taklif.site → "nodir-malika"
  slug       String           @unique
  /// src/templates/registry.ts dagi id
  templateId String
  status     InvitationStatus @default(DRAFT)
  locale     Locale           @default(UZ)

  groomName String
  brideName String
  /// To'y sanasi va boshlanish vaqti (countdown shu vaqtga hisoblanadi)
  eventAt   DateTime

  /// Bloklar mazmuni — src/lib/content.ts dagi zod sxemasi bo'yicha JSON
  content Json

  /// Vercel Blob URL'lari
  coverImage String?
  gallery    String[] @default([])
  music      String?
  /// Telegram preview uchun tayyor OG rasm (bo'lmasa avtomatik yasaladi)
  ogImage    String?

  // Mijoz va to'lov (faqat admin uchun)
  /// Qayerdan kelgan: admin qo'lda kiritdimi yoki bot orqali mijozmi
  source InvitationSource @default(ADMIN)

  clientName  String?
  clientPhone String?

  // ─── Telegram bot ───────────────────────────────────────────────────
  /// Botda to'ldirgan mijozning chat id'si (xabar yuborish uchun)
  tgChatId    BigInt?
  tgUsername  String?
  /// Mijoz botda "tayyor" deganda
  submittedAt DateTime?
  /// Admin tasdiqlaganda
  approvedAt  DateTime?
  price       Int?
  paid        Boolean   @default(false)
  note        String?

  /// Shu sanadan keyin ARCHIVED deb hisoblanadi
  expiresAt DateTime?
  views     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvps Rsvp[]

  @@index([status])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  attending Attendance
  guests    Int        @default(1)
  note      String?
  /// ?m= parametridan kelgan shaxsiy murojaat (kim orqali ochilgan)
  invitedAs String?
  createdAt DateTime   @default(now())

  @@index([invitationId, createdAt])
}

// ─── Shablon katalogi (admin boshqaradi; kod src/templates/ da) ───────────

model Template {
  /// src/templates/registry.ts dagi id bilan bir xil
  id          String   @id
  name        String
  /// Katalogdagi qisqa tavsif
  description String   @default("")
  /// Ichki sahifadagi to'liq matn
  body        String   @default("")
  /// "classic" | "floral" | "dark" | "national" | "minimal"
  category    String   @default("classic")
  /// so'mda; null bo'lsa "narx so'rang"
  price       Int?
  /// Katalog kartasi rasmi (Blob URL yoki /templates/<id>.jpg)
  thumbnail   String?
  /// Ichki sahifa uchun ekran rasmlari
  screens     String[] @default([])
  /// Ichki sahifada "Nimalar kiradi" ro'yxati
  features    String[] @default([])
  /// Kataloqda ko'rsatish
  published   Boolean  @default(true)
  /// Yangi / Mashhur kabi belgi
  badge       String?
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Telegram bot suhbati ─────────────────────────────────────────────────

model BotSession {
  /// Telegram chat id - bitta mijoz bitta suhbat
  chatId       BigInt  @id
  username     String?
  /// Ism (Telegram profilidan) - adminga ko'rsatish uchun
  fullName     String?
  /// Hozirgi qadam kaliti (src/lib/bot/flow.ts)
  step         String  @default("start")
  /// To'plangan javoblar
  data         Json    @default("{}")
  /// Tugagandan keyin yaratilgan taklifnoma
  invitationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ─── Fon musiqasi kutubxonasi ─────────────────────────────────────────────

model Track {
  id      String @id @default(cuid())
  title   String
  artist  String @default("")
  /// Vercel Blob havolasi
  url     String
  /// Davomiyligi, soniyada (ixtiyoriy)
  seconds Int?

  /// Mijozga (bot va admin ro'yxatida) ko'rinadimi
  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}
